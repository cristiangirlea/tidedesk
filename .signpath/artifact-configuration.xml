<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <!-- upload-artifact wraps the two executables in one ZIP. -->
  <zip-file>
    <pe-file path="tidedesk-host.exe" product-name="TideDesk"
             product-version="${version}" file-version="${version}"
             original-filename="tidedesk-host.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="tidedesk-view.exe" product-name="TideDesk"
             product-version="${version}" file-version="${version}"
             original-filename="tidedesk-view.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
